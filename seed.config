#
# seed.config - Openwrt-ninja 定制固件的包/目标选择
#
# 基础：官方 OpenWrt openwrt-25.12 分支（apk 包管理 + ucode/JS 版 LuCI），x86/64。
# build.sh 会把它复制成 .config，再由 'make defconfig' 展开。
#
# 写法约定（都是真机踩过的坑，别改回旧写法）：
#   - 字符串符号必须带引号：CONFIG_GRUB_TIMEOUT="0"，写成 =0 会被拒绝并退回默认 "5"。
#   - 关掉某项要写 "# CONFIG_X is not set"，且符号名必须是当前分支真实存在的名字，
#     名字不存在时这一行等于没写，功能会静默保留。
#   - luci-i18n-*-zh-cn 是**没有提示语的隐藏 tristate**，逐条手写会被 defconfig
#     静默丢弃，只能靠 CONFIG_LUCI_LANG_zh_Hans 点亮（见下方说明）。
#   - 每一项都会由 scripts/verify-config.sh 在 defconfig 之后逐条断言，被丢弃就直接
#     报错，绝不产出"少功能但构建成功"的固件。
#

# ============================================================
# Build options
# ============================================================
# 反复构建时用 ccache（GitHub Actions 那侧会把它缓存在 runner 上）。
# 纯本地一次性构建可以去掉这两行。
#
# 注意：25.12 里 config CCACHE 写在 config/Config-devel.in，条件是 `if DEVEL`，
# 所以只写 CONFIG_CCACHE=y 会被 defconfig 静默丢弃（第一次真机构建就是这么发现的）。
# CONFIG_DEVEL 本身在 rules.mk/include/target 里没有任何引用，纯粹是 menuconfig 的
# 菜单门禁，打开它不会改变镜像内容。
CONFIG_DEVEL=y
CONFIG_CCACHE=y

# ============================================================
# Target system
# ============================================================
CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# ============================================================
# Target Images
# ============================================================

# --- 分区大小 ---
CONFIG_TARGET_KERNEL_PARTSIZE=256
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# --- 文件系统镜像：只出 squashfs ---
# openwrt-x86-64-generic-squashfs-combined.img.gz 就是最终交付物（PVE 导入它）。
CONFIG_TARGET_ROOTFS_SQUASHFS=y
# CONFIG_TARGET_ROOTFS_EXT4FS is not set
# CONFIG_TARGET_ROOTFS_BTRFS is not set
# CONFIG_TARGET_ROOTFS_JFFS2 is not set
# CONFIG_TARGET_ROOTFS_UBIFS is not set
# CONFIG_TARGET_ROOTFS_ISO is not set
# CONFIG_TARGET_ROOTFS_CPIOGZ is not set
# CONFIG_TARGET_ROOTFS_TARGZ is not set
# CONFIG_TARGET_ROOTFS_EROTS is not set

# --- 引导：GRUB，仅 legacy BIOS，无 EFI ---
# 25.12 上 EFI 的符号名是 GRUB_EFI_IMAGES（旧名 EFI_IMAGES 已不存在），
# 且默认为 y，所以必须显式关掉。
CONFIG_GRUB_IMAGES=y
# CONFIG_GRUB_EFI_IMAGES is not set
CONFIG_GRUB_CONSOLE=y
CONFIG_GRUB_BAUDRATE=115200
CONFIG_GRUB_BOOTOPTS="quiet loglevel=0"
CONFIG_GRUB_TIMEOUT="0"
CONFIG_GRUB_TITLE="OpenWrt"
# 串口设备由 CONFIG_TARGET_SERIAL 提供，默认就是 "ttyS0"，无需重复设置；
# 老仓库里的 CONFIG_GRUB_SERIAL / QCOW_IMAGES 在当前分支已删除，写了也没用。

# --- 虚拟磁盘格式：全部不出（PVE 直接用 .img.gz） ---
# CONFIG_VDI_IMAGES is not set
# CONFIG_VMDK_IMAGES is not set

# --- 压缩 ---
CONFIG_TARGET_IMAGES_GZIP=y
# CONFIG_TARGET_IMAGES_ZSTD is not set

# ============================================================
# LuCI  web interface
# ============================================================
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-base=y
CONFIG_PACKAGE_luci-mod-admin-full=y
CONFIG_PACKAGE_luci-mod-network=y
CONFIG_PACKAGE_luci-mod-status=y
CONFIG_PACKAGE_luci-mod-system=y
CONFIG_PACKAGE_luci-app-firewall=y
CONFIG_PACKAGE_luci-app-package-manager=y
CONFIG_PACKAGE_luci-proto-ppp=y
CONFIG_PACKAGE_luci-lib-base=y
CONFIG_PACKAGE_luci-lib-ipkg=y

# --- Lua 运行时：本固件的两个预置插件都还是 Lua 时代的 UI ---
# 25.12 的 LuCI 前端已换成 ucode/JS，luci-compat 只剩 luasrc 里的 cbi/model/tools
# 库、**不再有 dispatcher**；旧式 controller/*.lua 要靠 luci-lua-runtime（它带
# luasrc/dispatcher.lua + ucodebridge.lua，并依赖 ucode-mod-lua）才能出页面。
# 关掉这两项的话 OpenClash / NinjaDesktop 的 Web 界面不会出现（后端服务仍正常）。
CONFIG_PACKAGE_luci-compat=y
CONFIG_PACKAGE_luci-lua-runtime=y

# ============================================================
# 主题 - Argon（两个仓库都由 build.sh 直接 clone 到 package/feeds/argon/）
# ============================================================
CONFIG_PACKAGE_luci-theme-argon=y
# 独立上游仓库（jerrykuku/luci-app-argon-config），不在主题仓库里，提供 系统 -> Argon 设置
CONFIG_PACKAGE_luci-app-argon-config=y

# ============================================================
# 简体中文
#
# 唯一有效的办法是打开总开关：luci.mk 把每个 luci-i18n-*-zh-cn 定义成无提示语的
# 隐藏 tristate（HIDDEN:=1 + DEFAULT:=LUCI_LANG_zh_Hans），手写
# CONFIG_PACKAGE_luci-i18n-xxx-zh-cn=y 会被 Kconfig 静默丢弃。
#
# 这不会拖进无关应用：每个隐藏 i18n 符号带 DEPENDS:=$(PKG_NAME)，也就是
# 'depends on PACKAGE_<对应应用>'，只有那个应用被构建时翻译包才可选。
#
# 三条容易踩的规则（都出自 luci.mk 的实现）：
#   1. 只有 **po/zh_Hans/**（真目录，或像 passwall 那样是指向 zh-cn 的符号链接）才会
#      生成翻译包。仓库里只有 po/zh-cn/ 的话，在 25.12 **什么都不会生成**：语言列表被
#      $(if $(LUCI_LANG.$(lang))) 过滤，而映射表里只有 zh_Hans / zh_Hant。
#   2. 包名后缀是 alias 后的 **zh-cn**（LUCI_LC_ALIAS.zh_Hans=zh-cn），不是目录名
#      zh_Hans。官方 25.12 仓库里能查到 luci-i18n-base-zh-cn.apk。
#   3. luci-i18n-argon-config-zh-cn 来自**主题仓库** jerrykuku/luci-theme-argon
#      （它显式写了 LUCI_BASENAME:=argon-config）；那个设置页小仓库自己没有 po。
#
# 覆盖面：luci-i18n-base-zh-cn 覆盖 luci-base 以及 core 的 status/system/network 模块
# （modules/luci-mod-* 自己没有 po 目录）。
#
# 两个预置插件不受这个开关影响，只看包内有没有 .lmo：
#   - luci-app-openclash 自带 usr/lib/lua/luci/i18n/openclash.zh-cn.lmo（还有 .es）
#   - ninjadesktop-lite **没有任何翻译文件**，界面是英文（专有包，补不了）
# 两者都走 Lua 路径的 i18n，所以除了装包，还要 luci-lua-runtime 才认这个目录。
# ============================================================
CONFIG_LUCI_LANG_zh_Hans=y

# ============================================================
# 插件
# ============================================================
CONFIG_PACKAGE_luci-app-passwall=y
CONFIG_PACKAGE_luci-app-timecontrol=y

# SoftEther：VPN 二进制 softethervpn5-* 来自官方 packages feed，服务端不会被任何
# LuCI 应用拉起，必须显式勾选。管理页面来自外部 feed
#   src-git softethervpn https://github.com/yujun-1982/luci-app-softethervpn.git
# 该 feed 自带 /etc/init.d/softethervpn（不用 procd）、持久化配置、自动保存压缩、
# 关机 Flush 和 sysupgrade 保留清单，并在 postinst/uci-defaults 里把上游那个
# /etc/init.d/softethervpnserver 关掉，避免两个脚本抢同一个 vpnserver。
CONFIG_PACKAGE_softethervpn5-server=y
CONFIG_PACKAGE_luci-app-softethervpn=y
# 可选：虚拟 HUB 做二层桥接时才需要
# CONFIG_PACKAGE_softethervpn5-bridge is not set
# 这是服务端设备，显式钉住不装客户端（连带避免客户端的自启行为）
# CONFIG_PACKAGE_softethervpn5-client is not set

# ============================================================
# WireGuard - 只装组件，故意不预配置
#
# kmod-wireguard 是内核实现，wireguard-tools 提供 wg(8)/wg-quick(8)，
# luci-proto-wireguard 在 网络 -> 接口 里加 "WireGuard 隧道" 类型。
# 本 LuCI 版本里没有 luci-app-wireguard，协议包就是唯一入口。
# 不预置接口/密钥/防火墙规则：私钥是站点级机密，而这个仓库是公开的。
#   wg genkey | tee privatekey | wg pubkey > publickey
# ============================================================
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# ============================================================
# 分流 - 官方内核 nftables 实现
# （在 files/etc/config/firewall 的 lan zone 里启用）
# ============================================================
CONFIG_PACKAGE_kmod-nft-offload=y
CONFIG_PACKAGE_kmod-nft-nat=y

# ============================================================
# 预置插件 luci-app-openclash 的运行依赖
#
# 这个 .apk 自己声明的依赖（已从包内 ADB 元数据核对，名字在 25.12 全部有效）：
#   dnsmasq-full bash curl ca-bundle ip-full jsonfilter ruby ruby-yaml kmod-tun unzip
# 下面把它们连同 OpenClash 脚本实际会用的 tproxy/ipset 组件一起编进镜像，
# 所以镜像刷完**不需要联网**就能用。
#
# 关于 "ruby 是否改名 ruby3"：没有改名。openwrt-25.12 的 packages feed
# lang/ruby 仍是 PKG_NAME:=ruby（ruby 3.4.9），子包仍是 ruby-<库名>，
# 官方仓库里能查到 ruby-3.4.9-r1.apk 与 ruby-yaml-3.4.9-r1.apk。
# ============================================================
CONFIG_PACKAGE_bash=y
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_jsonfilter=y
CONFIG_PACKAGE_unzip=y
CONFIG_PACKAGE_ruby=y
CONFIG_PACKAGE_ruby-yaml=y
CONFIG_PACKAGE_ip-full=y
CONFIG_PACKAGE_kmod-tun=y
# 25.12 里**没有** CONFIG_PACKAGE_iptables / CONFIG_PACKAGE_ip6tables：iptables、ip6tables
# 只是 PROVIDES 出来的虚拟名，真实符号是 iptables-nft / iptables-zz-legacy 与
# ip6tables-nft / ip6tables-zz-legacy（xtables-nft / xtables-legacy 是背后的多合一二进制）。
# 本固件用 firewall4/nftables，所以选 nft 变体：/usr/sbin/iptables 由 ALTERNATIVES 指到
# xtables-nft-multi，OpenClash 里那些 `iptables -t nat` 调用走的还是 nft。
CONFIG_PACKAGE_ipset=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_ip6tables-nft=y
CONFIG_PACKAGE_iptables-mod-tproxy=y
CONFIG_PACKAGE_kmod-ipt-tproxy=y
CONFIG_PACKAGE_kmod-ipt-nat=y
CONFIG_PACKAGE_kmod-ipt-nat6=y
CONFIG_PACKAGE_coreutils=y
CONFIG_PACKAGE_coreutils-nohup=y

# dnsmasq-full 取代默认的 mini dnsmasq（OpenClash 需要它）
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# ============================================================
# 两个本地现成插件包（本仓库 package/ 里的 wrapper，见 README）
#
# 它们在 make 的 package/install 阶段就随其它包一起装进 staged rootfs，
# **不再靠首次开机的 uci-defaults 安装**，因此会出现在固件 .manifest 里。
# ============================================================
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_ninjadesktop-lite=y

# ============================================================
# 基础工具与网络诊断
# ============================================================
CONFIG_PACKAGE_htop=y
CONFIG_PACKAGE_ethtool=y
CONFIG_PACKAGE_tcpdump=y
CONFIG_PACKAGE_iperf3=y
CONFIG_PACKAGE_bind-dig=y
# mtr 在 25.12 是变体包：mtr-nojson / mtr-json（裸 mtr 只是 Makefile 里的 /Default 模板名，
# 写成 CONFIG_PACKAGE_mtr=y 会被静默丢弃）。要 -j 的 JSON 输出就换成 mtr-json（多拉一个 jansson）。
CONFIG_PACKAGE_mtr-nojson=y
CONFIG_PACKAGE_pciutils=y
CONFIG_PACKAGE_usbutils=y
