config interface 'loopback'
	option device 'lo'
	option proto 'static'
	option ipaddr '127.0.0.1'
	option netmask '255.0.0.0'

config device
	option name 'br-lan'
	option type 'bridge'
	list ports 'eth0'
	# SoftEther's local bridge runs over a TAP; S19softethertaps creates it before
	# netifd assembles br-lan, because a port that does not exist yet is skipped.
	list ports 'tap_eth0'

config interface 'lan'
	option device 'br-lan'
	option proto 'static'
	option ipaddr '10.10.10.2'
	option netmask '255.255.255.0'
